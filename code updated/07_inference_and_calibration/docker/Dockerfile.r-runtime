FROM rocker/r-ver:4.3.3

LABEL org.opencontainers.image.source="https://github.com/ALRIER/T3"
LABEL org.opencontainers.image.description="Pinned R runtime for T3 B3 workflows"

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/* \
 && R -q -e "install.packages('https://cran.r-project.org/src/contrib/statmod_1.5.2.tar.gz', repos=NULL, type='source')" \
 && R -q -e "stopifnot(as.character(packageVersion('statmod')) == '1.5.2')" \
 && R -q -e "install.packages('jsonlite',repos='https://cloud.r-project.org')"

WORKDIR /github/workspace
